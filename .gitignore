*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel
.env*
prod-check.mjs
qa-*.mjs
qa-*.xlsx

# datos de negocios exportados/scrapeados (son datos del usuario, no código)
negocios-*.xlsx
negocios-local-*.xlsx
