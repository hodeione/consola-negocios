// Prisma schema — scraper de negocios + consola CRM
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Usuarios / roles
// ─────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  AGENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(AGENT)
  // Desactivar en vez de borrar: borrar un usuario arrastraría en cascada
  // (onDelete: Cascade) todos los negocios que ha scrapeado.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  batchJobs         BatchJob[]    @relation("BatchJobOwner")
  scrapeTasks       ScrapeTask[]  @relation("ScrapeTaskOwner")
  ownedBusinesses   Business[]    @relation("BusinessOwner")
  assignedBusiness  Business[]    @relation("BusinessAssignee")
  callActivities    CallActivity[]
  timeEntries       TimeEntry[]
  auditLogs         AuditLog[]
  passwordResetTokens PasswordResetToken[]
  loginEvents       LoginEvent[]
  notesAboutMe      AgentNote[] @relation("AgentNoteSubject")
  notesIWrote       AgentNote[] @relation("AgentNoteAuthor")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Recuperar contraseña: token de un solo uso enviado por email. Se
// guarda el HASH del token (nunca el token en claro) — igual que una
// contraseña, así una fuga de la base de datos no lo compromete.
// ─────────────────────────────────────────────────────────────
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────
// Control horario: un fichaje = una entrada abierta (clockOut null)
// hasta que se cierra. Solo puede haber un fichaje abierto por usuario
// a la vez (se comprueba en la API, no aquí).
// ─────────────────────────────────────────────────────────────
enum TimeEntryType {
  WORK
  VACATION
  ABSENCE
}

model TimeEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  // WORK = fichaje normal (entra en horas trabajadas / detección de
  // inactividad). VACATION/ABSENCE las crea el admin a mano, con rango ya
  // cerrado — no cuentan como tiempo trabajado ni disparan avisos de "posible
  // inactividad", porque no lo son.
  type      TimeEntryType @default(WORK)
  note      String    @default("")
  // Si el admin corrige un fichaje a mano (olvidado, mal cerrado...) queda anotado.
  editedByAdmin Boolean @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, clockIn])
  @@map("time_entries")
}

// ─────────────────────────────────────────────────────────────
// Scraping: lotes y tareas
// ─────────────────────────────────────────────────────────────
enum BatchJobStatus {
  PENDING
  RUNNING
  DONE
}

model BatchJob {
  id                 String         @id @default(cuid())
  ownerId            String
  owner              User           @relation("BatchJobOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  keywords           String[]
  zones              String[]
  maxResultsPerCombo Int            @default(60)
  language           String         @default("es")
  status             BatchJobStatus @default(PENDING)
  createdAt          DateTime       @default(now())

  tasks ScrapeTask[]

  @@index([ownerId])
  @@map("batch_jobs")
}

enum ScrapeTaskStatus {
  PENDING
  COLLECTING // recogiendo enlaces de resultados en Google Maps (scroll)
  DETAILING  // visitando la ficha de cada lugar (nombre, tel., web, rating...)
  ENRICHING  // extrayendo emails/teléfonos de la web de cada negocio
  DONE
  ERROR
  CANCELLED
}

model ScrapeTask {
  id          String           @id @default(cuid())
  batchJobId  String
  batchJob    BatchJob         @relation(fields: [batchJobId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User             @relation("ScrapeTaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  keyword     String
  zone        String
  maxResults  Int              @default(60)
  language    String           @default("es")
  status      ScrapeTaskStatus @default(PENDING)
  // Estado reanudable: enlaces de Maps ya recogidos, cursor de scroll,
  // índice del siguiente negocio a enriquecer, urls ya vistas, etc.
  cursor      Json             @default("{}")
  foundCount  Int              @default(0)
  totalCount  Int              @default(0)
  message     String           @default("")
  error       String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  businesses Business[]

  @@index([ownerId, status])
  @@index([batchJobId])
  @@map("scrape_tasks")
}

// ─────────────────────────────────────────────────────────────
// Negocios (CRM)
// ─────────────────────────────────────────────────────────────
enum CallStatus {
  PENDING
  NO_ANSWER
  CALLBACK_LATER
  INTERESTED
  NOT_INTERESTED
  CUSTOMER
  INVALID_NUMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Catálogo real de productos que se venden desde la consola.
enum ProductType {
  LANDING
  SEO
  ECOMMERCE
  SAAS
  CUSTOM
  OTHER
}

model Business {
  id               String     @id @default(cuid())
  ownerId          String
  owner            User       @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignedToUserId String?
  assignedTo       User?      @relation("BusinessAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  sourceTaskId     String?
  sourceTask       ScrapeTask? @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)

  // Datos scrapeados
  name       String
  address    String   @default("")
  mapsPhone  String   @default("")
  website    String   @default("")
  // Enlace real a la ficha de Google Maps — permite re-scrapearla más
  // adelante sin tener que repetir la búsqueda entera. Puede faltar en
  // negocios guardados antes de que existiera este campo.
  mapsUrl    String   @default("")
  emails     String[]
  webPhones  String[]
  rating     Float    @default(0)
  category   String   @default("")
  zone       String
  keyword    String
  // Alguien marcó algún dato de esta ficha como incorrecto/caducado —
  // señal para revisar, no se borra ni se corrige solo.
  flaggedIncorrect    Boolean  @default(false)
  flaggedIncorrectNote String  @default("")

  // "¿Necesita un servicio digital?" — calculado al scrapear/re-scrapear a
  // partir de si tiene web, si esa "web" es en realidad solo un enlace a
  // Facebook/Instagram, si responde, si tiene SSL y si es responsive (ver
  // src/lib/scraper/digital-need.ts). No sustituye el criterio del agente,
  // solo ayuda a priorizar a quién llamar primero.
  digitalNeedSignals String[] @default([])
  digitalNeedScore   Int      @default(0)

  // Gestión / CRM
  status         CallStatus @default(PENDING)
  priority       Priority   @default(MEDIUM)
  contactName    String     @default("")
  contactRole    String     @default("")
  tags           String[]
  nextFollowUpAt DateTime?
  lastCalledAt   DateTime?

  // Venta: solo tiene sentido relleno cuando status = CUSTOMER, pero se deja
  // libre por si se quiere anotar una venta parcial/estimada antes de cerrar.
  dealValue Float        @default(0)
  product   ProductType?
  closedAt  DateTime?
  // "Cerrado" (closedAt) no es lo mismo que "cobrado" — se separan para poder
  // ver facturado-pero-no-cobrado en las estadísticas.
  paid      Boolean      @default(false)
  paidAt    DateTime?

  // Frescura: cuándo se comprobaron por última vez estos datos (al scrapear,
  // reimportar o re-verificar la ficha). Sirve para detectar negocios con
  // teléfono/web potencialmente caducados.
  lastVerifiedAt DateTime @default(now())

  // Deduplicación: web normalizada, o "tel|nombre" si no hay web. Única por owner.
  dedupeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  callActivities CallActivity[]
  auditLogs      AuditLog[]

  @@unique([ownerId, dedupeKey])
  @@index([ownerId, status])
  @@index([assignedToUserId, status])
  @@index([ownerId, nextFollowUpAt])
  @@index([zone])
  @@index([ownerId, digitalNeedScore])
  @@map("businesses")
}

model CallActivity {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome    CallStatus
  notes      String     @default("")
  createdAt  DateTime   @default(now())

  @@index([businessId])
  @@map("call_activities")
}

// ─────────────────────────────────────────────────────────────
// Auditoría: quién cambió qué en la gestión de un negocio (reasignaciones,
// cambios de prioridad/estado/etiquetas). Independiente del historial de
// llamadas (CallActivity), que solo cubre resultados de llamada.
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "reassigned" | "priority_changed" | "status_changed" | "tags_changed"
  action  String
  detail  String   @default("")
  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Registro de inicios de sesión — quién entró, cuándo, desde dónde.
// ─────────────────────────────────────────────────────────────
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_events")
}

// ─────────────────────────────────────────────────────────────
// Notas privadas del admin sobre el desempeño de un agente — no ligadas a
// ningún negocio en concreto (para eso ya está el Historial de cada ficha).
// ─────────────────────────────────────────────────────────────
model AgentNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("AgentNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AgentNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("agent_notes")
}
